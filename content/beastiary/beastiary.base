filters:
  and:
    - file.inFolder("content/shattered-sea/public/beastiary")
views:
  - type: table
    name: Table
    filters:
      and:
        - cr > 1
    groupBy:
      property: creature_type
      direction: ASC
    order:
      - file.name
      - cr
      - creature_type
      - campaign
      - cha
      - con
      - dex
      - int
      - str
      - wis
      - publish
      - title
      - aliases
      - summary
    sort:
      - property: cr
        direction: ASC
    columnSize:
      note.cr: 47
      note.campaign: 131
      note.cha: 57
      note.con: 55
      note.dex: 54
      note.int: 48
      note.str: 56
      note.wis: 57
      note.aliases: 168
